# =====================================================================
# Maremereso Olga — backend configuration
#
# Copy to .env and fill in. Values marked REQUIRED have no default: the
# server refuses to start without them, so a missing secret fails loudly
# instead of silently falling back to a well-known value.
# =====================================================================

PORT=8080

# "production" tightens CORS to CUSTOMER_URL/ADMIN_URL only and raises the
# log level so customer phone numbers stop being written to the log.
APP_ENV=development

# ----- PostgreSQL -----
DB_HOST=localhost
DB_PORT=5432
DB_USER=                      # REQUIRED
DB_PASSWORD=
DB_NAME=maremereso_olga
DB_SSLMODE=disable            # use "require" for a remote database

# ----- JWT -----
# REQUIRED, minimum 32 characters. Generate one with:
#   openssl rand -base64 48
# Rotating this invalidates every active customer and staff session.
JWT_SECRET=

# ----- Midtrans -----
# REQUIRED. From the Midtrans dashboard (Settings -> Access Keys).
# The server key also verifies the SHA-512 signature on payment webhooks, so
# an incorrect value causes every notification to be rejected.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PROD=false        # true switches to the live Midtrans endpoint

# ----- File upload -----
UPLOAD_DIR=./uploads

# ----- URLs -----
# CUSTOMER_URL and ADMIN_URL are the CORS and WebSocket origin allowlist, and
# CUSTOMER_URL is where Midtrans returns the customer after payment.
BASE_URL=http://localhost:8080
CUSTOMER_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ----- Geocoding -----
# Address search and reverse geocoding are proxied through the backend so the
# provider's rate limit and User-Agent policy are respected in one place.
# The default is OpenStreetMap Nominatim, whose fair-use policy is ~1 req/s.
# Supply a contact address (Nominatim asks for one), or point GEOCODER_URL at
# a commercial provider with a compatible API if you outgrow it.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_EMAIL=

# ----- Email Alerts -----
# Optional SMTP configuration for sending automatic error alerts on internal server panics.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=secretpassword
ALERT_FROM_EMAIL=alerts@example.com
ALERT_TO_EMAIL=admin@example.com
